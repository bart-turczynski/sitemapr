<?xml version="1.0" encoding="UTF-8"?>
<!-- A sitemapindex whose only child <loc> is a feed. Supported dialects
     (RSS 2.0 / Atom) parse into rows; an unsupported one (a <feed> in a
     non-Atom namespace) yields UNSUPPORTED_FEED. No test reads this file now:
     test-validate-sitemap.R covers both cases with an index built in memory
     (vs_feed_index_mock()), since expansion only runs for a URL source. -->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap><loc>https://example.com/feed.xml</loc></sitemap>
</sitemapindex>
